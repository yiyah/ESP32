{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (host-debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "host-debug", "-S", "${workspaceFolder}/components/panel/test"],
      "problemMatcher": []
    },
    {
      "label": "cmake: build (host-debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/components/panel/test/build-host"],
      "dependsOn": "cmake: configure (host-debug)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "cmake: configure (host-asan)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "host-asan", "-S", "${workspaceFolder}/components/panel/test"],
      "problemMatcher": []
    },
    {
      "label": "cmake: build (host-asan)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/components/panel/test/build-host-asan"],
      "dependsOn": "cmake: configure (host-asan)",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
