{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug (macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_FLAGS": "-g -O0"
      }
    },
    {
      "name": "host-asan",
      "displayName": "Host Debug with ASan (macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-host-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_FLAGS": "-g -O0 -fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    }
  ]
}
